{
	"name": "pendek",
	"version": "1.0.0",
	"private": true,
	"description": "Minimal URL shortener — Bun + Elysia + Prisma backend, Vite React frontend.",
	"scripts": {
		"install:backend": "cd backend && bun install",
		"install:frontend": "cd frontend && bun install",
		"install": "bun install:backend && bun install:frontend",
		"dev:backend": "cd backend && bun --watch index.js",
		"dev:frontend": "cd frontend && bun dev",
		"dev": "conc -n \"BACKEND,FRONTEND\" -c \"cyan,yellow\" \"bun run dev:backend\" \"bun run dev:frontend\"",
		"test:backend": "cd backend && bun test",
		"build:client": "cd frontend && bun run build",
		"build": "bun run build:client",
		"db:migrate": "cd backend && bun prisma db push",
		"start": "cd backend && PORT=5000 bun index.js"
	},
	"devDependencies": {
		"concurrently": "^9.0.0"
	}
}