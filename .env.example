# Copy to .env — never commit real values (.env is gitignored).
# Note: no spaces around "=" — a shell `source .env` breaks on "KEY = value".

# --- app (backend/config.js) ---
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
ALLOWED_HOSTS=
# Set true only behind a reverse proxy (Traefik) that appends X-Forwarded-For
TRUST_PROXY=false
# true = disable anonymous link creation on the home page
DISABLE_AUTO_CREATE=false
MAX_URLS_PER_LINK=10
MAX_URL_LENGTH=2048
MAX_TAG_LENGTH=50
TZ=Asia/Kuala_Lumpur

# --- database ---
POSTGRES_URL=postgresql://user:password@localhost:5432/pendek_dev

# --- iron-session (>=32 chars; generate with: openssl rand -hex 32) ---
COOKIE_PASSWORD=
COOKIE_NAME=pendek_session
COOKIE_TTL=604800
LOGOUT_TIME=86400
